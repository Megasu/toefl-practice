{
  "name": "toefl-practice-replica",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:static": "node scripts/prepare-static.mjs",
    "prepare:listening": "npm run prepare:static",
    "test:sentences": "node scripts/test-sentence-bank.mjs",
    "test:listening": "node scripts/test-listening-bank.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run prepare:static && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:listening": "npm run dev",
    "build": "npm run prepare:static && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
